{
  "type": "Categorization",
  "elements": [
    {
      "type": "Category",
      "label": "Здобувач",
      "elements": [
        {
          "type": "Control",
          "label": "ПІБ здобувача ступеня доктора філософії",
          "scope": "#/properties/student/properties/studentName"
        },
        {
          "type": "Control",
          "label": "Стать здобувача",
          "scope": "#/properties/student/properties/studentGender"
        },
        {
          "type": "Control",
          "label": "Освітньо-наукова програма",
          "scope": "#/properties/student/properties/op"
        },
        {
          "type": "Control",
          "label": "Окремі елементи освітньо-наукової програми забезпечуються іншим закладом вищої освіти/науковою установою (у тому числі іноземним)",
          "scope": "#/properties/student/properties/opInCooperationWithAnotherHei"
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "label": "Дата початку підготовки за ОНП",
              "scope": "#/properties/student/properties/startONPTime"
            },
            {
              "type": "Control",
              "label": "Дата завершення підготовки за ОНП",
              "scope": "#/properties/student/properties/endONPTime"
            },
            {
              "type": "Control",
              "label": "Дата завершення навчання на попередньому освітньому рівні",
              "scope": "#/properties/student/properties/endLastEduLevelTime"
            }
          ]
        }
      ]
    },
    {
      "type": "Category",
      "label": "Дисертація",
      "elements": [
        {
          "type": "Control",
          "label": "Тема дисертації",
          "scope": "#/properties/thesis/properties/thesisTopic"
        },
        {
          "type": "Control",
          "label": "Ключові слова",
          "scope": "#/properties/thesis/properties/thesisKeywords"
        },
        {
          "type": "Control",
          "label": "Посилання, за яким розміщено текст дисертації",
          "scope": "#/properties/thesis/properties/thesisLink"
        },
        {
          "type": "Control",
          "label": "Анотація дисертації",
          "scope": "#/properties/thesis/properties/thesisAnnotation",
          "options": {
            "multi": true
          }
        },
        {
          "type": "AccordionGroup",
          "label": "Публікації здобувача за темою дисертації",
          "elements": [
            {
              "type": "ListWithDetail",
              "label": "Список",
              "scope": "#/properties/thesis/properties/thesisPublications",
              "options": {
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "label": "Тип публікації",
                      "scope": "#/properties/type"
                    },
                    {
                      "type": "Control",
                      "label": "DOI",
                      "scope": "#/properties/doi",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/type",
                          "schema": {
                            "enum": [
                              "Публікація в українському періодичному фаховому виданні",
                              "Публікація в іноземному періодичному індексованому в WoS/Scopus виданні"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "label": "ISSN (e-ISSN) видання",
                      "scope": "#/properties/issn",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/type",
                          "schema": {
                            "enum": [
                              "Публікація в іноземному періодичному індексованому в WoS/Scopus виданні"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "label": "Посилання",
                      "scope": "#/properties/link"
                    },
                    {
                      "type": "Control",
                      "label": "Бібліографічний опис",
                      "scope": "#/properties/description",
                      "options": {
                        "multi": true
                      }
                    },
                    {
                      "type": "Control",
                      "label": "Рік публікації",
                      "scope": "#/properties/year"
                    },
                    {
                      "type": "Control",
                      "label": "Ключові слова",
                      "scope": "#/properties/keywords"
                    },
                    {
                      "type": "Control",
                      "label": "Публікація є одноосібною",
                      "scope": "#/properties/hasSoleAuthorship"
                    },
                    {
                      "type": "Control",
                      "label": "Публікація містить державну таємницю/службову інформацію",
                      "scope": "#/properties/hasSecrets"
